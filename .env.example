# Nusxa oling:  cp .env.example .env   so'ng qiymatlarni to'ldiring.  .env HECH QACHON gitga qo'shilmaydi!
# Sirlarni yaratish:  python scripts/gen_secrets.py

# @BotFather -> /newbot dan olingan token. Token oshkor bo'lsa BotFather'da /revoke qiling.
BOT_TOKEN=CHANGE_ME

# Ochiq HTTPS manzil (domen yoki tunnel), oxirida "/" siz. Telegram faqat HTTPS webhook qabul qiladi.
WEBHOOK_BASE_URL=https://CHANGE_ME.example.com

# scripts/gen_secrets.py chiqargan qiymatlar
WEBHOOK_SECRET=CHANGE_ME
WORKER_TOKEN=CHANGE_ME
DATA_KEY=CHANGE_ME

# Admin Telegram USER ID'lari (raqam!, username emas), vergul bilan. ID ni @userinfobot dan bilib oling.
ADMIN_IDS=000000000

# Faqat Caddy (compose --profile proxy) uchun: domen nomi
DOMAIN=CHANGE_ME.example.com

# Ixtiyoriy sozlamalar (standart qiymatlar):
# MAX_FILE_MB=20
# MSG_LIMIT=20          # xabar / MSG_WINDOW soniya
# MSG_WINDOW=60
# FILE_LIMIT=5          # fayl / FILE_WINDOW soniya
# FILE_WINDOW=600
# RETENTION_DAYS=30
