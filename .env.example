# Nusxa oling:  cp .env.example .env   so'ng qiymatlarni to'ldiring.  .env HECH QACHON gitga qo'shilmaydi!
# Sirlarni yaratish:  python scripts/gen_secrets.py

# @BotFather -> /newbot dan olingan token
BOT_TOKEN=CHANGE_ME

# Render bergan URL (Settings -> Service URL), masalan: https://cdr-bot.onrender.com
# /newbot dan keyin shu manzilni yozing - oxirida "/" bo'lmasin
WEBHOOK_BASE_URL=https://CHANGE_ME.onrender.com

# scripts/gen_secrets.py chiqargan qiymatlar
WEBHOOK_SECRET=CHANGE_ME
WORKER_TOKEN=CHANGE_ME
DATA_KEY=CHANGE_ME

# Admin Telegram USER ID'lari (raqam!, username emas), vergul bilan
# ID ni @userinfobot dan bilib oling
ADMIN_IDS=000000000

# Render ichida worker manzili (o'zgartirmang)
WORKER_URL=http://127.0.0.1:8081

# Render porti
PORT=8080

# Render xotirasiga mos xavfsiz parametrlar (OOM killer oldini olish uchun)
JOB_MEM_MB=350
WORKER_CONCURRENCY=1

# Ixtiyoriy sozlamalar (standart qiymatlar):
# MAX_FILE_MB=20
# MSG_LIMIT=20
# MSG_WINDOW=60
# FILE_LIMIT=5
# FILE_WINDOW=600
# RETENTION_DAYS=30
